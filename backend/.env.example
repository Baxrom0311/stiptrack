REFRESH_TOKEN_EXPIRE_DAYS=30
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["*"]
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_AUTH_REGISTER=5/minute
