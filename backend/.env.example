RATE_LIMIT_VALUE_UPLOAD=30/minute
RATE_LIMIT_ACHIEVEMENT_UPLOAD=30/minute
RATE_LIMIT_APPLICATION_SUBMIT=15/minute
RATE_LIMIT_WINNER_ANNOUNCE=5/hour
RATE_LIMIT_APPEAL_CREATE=5/hour
RATE_LIMIT_APPEAL_UPLOAD=10/hour

