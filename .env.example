# ==============================================================
# StipTrack — Docker Compose Environment Variables
# ==============================================================
# Bu faylni `.env` nomi bilan saqlang (docker-compose.yml yonida)
# Production uchun barcha qiymatlarni o'zgartiring!
# ==============================================================

# --- Security (MAJBURIY) ---
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_64_CHAR_STRING

# --- CORS (production domainlarni kiriting) ---
ALLOWED_ORIGINS=["https://yourdomain.uz"]

# --- PostgreSQL ---
POSTGRES_DB=stipendiya_db
POSTGRES_USER=stipuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# --- MinIO (S3 compatible storage) ---
MINIO_ROOT_USER=stipminio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD_HERE

# --- Nginx ---
# Tashqariga chiqadigan yagona port (prod)
NGINX_PORT=80

# --- Frontend ---
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_NAME=Stipendiya Platform

# --- Dev uchun portlar (faqat docker-compose.yml) ---
# Prod da ishlatilmaydi, chunki faqat nginx tashqariga chiqadi
DB_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
BACKEND_PORT=8000
MCP_PORT=8001
FRONTEND_PORT=3000
